# Leave this false while the contact form is not yet operational.
# Change it to true only after the Hostinger mailbox, Turnstile, and private PHP configuration are ready.
VITE_CONTACT_FORM_ENABLED=false

# This site key is public and is compiled into the browser bundle when the form is enabled.
# Copy this file to .env.production.local and replace the test value with the real production site key.
# Never put the Turnstile secret or the contacto@redepchile.com mailbox password in a VITE_ variable.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
